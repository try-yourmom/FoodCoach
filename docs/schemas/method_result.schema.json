{
  "$defs": {
    "FoodItem": {
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "mask_area_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Area Ratio"
        },
        "estimated_grams": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Grams"
        },
        "nutrition": {
          "$ref": "#/$defs/NutritionEstimate"
        },
        "verdict": {
          "$ref": "#/$defs/FoodVerdict"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "name",
        "confidence",
        "nutrition",
        "verdict"
      ],
      "title": "FoodItem",
      "type": "object"
    },
    "FoodVerdict": {
      "properties": {
        "calorie_status": {
          "title": "Calorie Status",
          "type": "string"
        },
        "protein_status": {
          "title": "Protein Status",
          "type": "string"
        },
        "carb_ratio": {
          "title": "Carb Ratio",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "calorie_status",
        "protein_status",
        "carb_ratio",
        "summary"
      ],
      "title": "FoodVerdict",
      "type": "object"
    },
    "MealTotals": {
      "properties": {
        "calories": {
          "default": 0,
          "minimum": 0,
          "title": "Calories",
          "type": "integer"
        },
        "protein_g": {
          "default": 0,
          "minimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "carbs_g": {
          "default": 0,
          "minimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "fat_g": {
          "default": 0,
          "minimum": 0,
          "title": "Fat G",
          "type": "number"
        }
      },
      "title": "MealTotals",
      "type": "object"
    },
    "MealVerdict": {
      "properties": {
        "calorie_status": {
          "title": "Calorie Status",
          "type": "string"
        },
        "protein_status": {
          "title": "Protein Status",
          "type": "string"
        },
        "carb_ratio": {
          "title": "Carb Ratio",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "calorie_status",
        "protein_status",
        "carb_ratio",
        "summary"
      ],
      "title": "MealVerdict",
      "type": "object"
    },
    "NutritionEstimate": {
      "properties": {
        "calories": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Calories",
          "type": "integer"
        },
        "protein_g": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Protein G",
          "type": "number"
        },
        "carbs_g": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Carbs G",
          "type": "number"
        },
        "fat_g": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Fat G",
          "type": "number"
        },
        "note": {
          "default": "估算值",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "calories",
        "protein_g",
        "carbs_g",
        "fat_g"
      ],
      "title": "NutritionEstimate",
      "type": "object"
    }
  },
  "properties": {
    "method": {
      "enum": [
        "traditional",
        "vlm"
      ],
      "title": "Method",
      "type": "string"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "degraded",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "foods": {
      "items": {
        "$ref": "#/$defs/FoodItem"
      },
      "title": "Foods",
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/MealTotals"
    },
    "verdict": {
      "$ref": "#/$defs/MealVerdict"
    },
    "advice": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Advice",
      "type": "array"
    },
    "long_term_note": {
      "title": "Long Term Note",
      "type": "string"
    },
    "disclaimer": {
      "default": "仅供学习参考，不构成医疗或营养建议。",
      "title": "Disclaimer",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "overlay_image_base64": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlay Image Base64"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "method",
    "verdict",
    "long_term_note"
  ],
  "title": "MethodResult",
  "type": "object"
}