# Qwen3.8-Omni-Flash via Alibaba Cloud DashScope OpenAI-compatible endpoint.
DASHSCOPE_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-omni-flash
VLM_TIMEOUT_SECONDS=90
VLM_ALLOW_MOCK=false

# Use "auto", "0" for the first CUDA GPU, or "cpu".
DEVICE=auto
YOLO_MODEL=models/yolov8s-worldv2.pt
SAM_MODEL=models/mobile_sam.pt
DETECTION_CONFIDENCE=0.20
API_BASE_URL=http://127.0.0.1:8000
# Authentication and persistence
DATABASE_URL=sqlite:///instance/foodcoach.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
